{
  "name": "mcp-knowledge",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun ui:css && bun --watch apps/server/src/index.ts",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "test": "bun test",
    "ui:css": "tailwindcss -i apps/server/src/ui/styles.css -o apps/server/src/ui/styles.built.css",
    "spike:anydoc": "bun scripts/spike-anydoc.ts",
    "spike:anydoc:spawn": "bun scripts/spike-anydoc-spawn.ts",
    "spike:embed": "bun scripts/spike-embed.ts",
    "spike:embed:worker": "bun scripts/spike-embed-worker.ts"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@tailwindcss/cli": "^4.1.13",
    "bun-types": "^1.4.0",
    "tailwindcss": "^4.1.13"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.2.4",
    "@huggingface/transformers": "^4.2.0"
  }
}
