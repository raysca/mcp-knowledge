{
  "name": "mcp-knowledge",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun ui:css && bun --watch apps/server/src/index.ts",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "release:smoke": "bun scripts/release/smoke.ts",
    "release:test-platforms": "bash scripts/release/test-platforms.sh",
    "release:check": "bash scripts/release/check.sh",
    "scale": "bun scripts/scale/run.ts",
    "ui:css": "tailwindcss -i apps/server/src/ui/styles.css -o apps/server/src/ui/styles.built.css",
    "spike:anydoc": "bun scripts/spike-anydoc.ts",
    "spike:anydoc:spawn": "bun scripts/spike-anydoc-spawn.ts",
    "spike:embed": "bun scripts/spike-embed.ts",
    "spike:embed:worker": "bun scripts/spike-embed-worker.ts"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/cli": "^4.1.13",
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "adm-zip": "0.5.18",
    "bun-types": "^1.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.2.4",
    "@huggingface/transformers": "^4.2.0"
  }
}
